<UserControl x:Class="BlockifyLauncher.MVVM.Views.Components.LoaderComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="72" d:DesignWidth="320">
    <!-- download toast: glass panel + XP progress bar -->
    <Border Style="{StaticResource ProcessBarBorder}" Tag="{Binding Activ}" Name="Loading"
            Background="#F0111417" BorderBrush="#2BFFFFFF" BorderThickness="1"
            Height="72" Width="320" Panel.ZIndex="111" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="15,10,15,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Foreground="#FFF"
                           FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" Foreground="#7DFF5F" FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="315" Color="#000000" Opacity="0.7"/>
                    </TextBlock.Effect>
                    <Run Text="{Binding Value, StringFormat={}{0:0}}"/><Run Text=" / "/><Run Text="{Binding Maximum, StringFormat={}{0:0}}"/>
                </TextBlock>
            </DockPanel>

            <ProgressBar Grid.Row="1" Style="{StaticResource XpProgressBar}" Margin="0,7,0,6"
                         Value="{Binding Value}" Maximum="{Binding Maximum}"/>

            <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#9FB2C0" FontSize="10"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
