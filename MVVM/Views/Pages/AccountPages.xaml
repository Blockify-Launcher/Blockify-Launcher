<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.AccountPages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="AccountPages">

    <Page.Resources>
        <Style x:Key="GInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource G.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource G.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource G.Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="10" Background="#40000000" BorderBrush="{StaticResource G.Line}" BorderThickness="1" Padding="12,10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource G.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,4,30,20">
        <StackPanel>
            <TextBlock Text="{Binding [sec_data], Source={x:Static lang:ResxLocalizationProvider.Instance}, FallbackValue=Аккаунты}"
                       FontFamily="{StaticResource G.Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource G.Text}"/>
            <TextBlock Text="Профили для входа. Активный используется при запуске — переключение в один клик."
                       Foreground="{StaticResource G.Muted}" FontSize="13" Margin="0,5,0,18"/>

            <!-- account list -->
            <StackPanel x:Name="AccountList"/>

            <!-- add cards -->
            <Grid Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassPanel2}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding [login_microsoft], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                   FontSize="14.5" FontWeight="ExtraBold" Foreground="{StaticResource G.Text}"/>
                        <TextBlock Text="Официальные сервера, скины и плащи из профиля, доступ к Realms. Пароль в лаунчер не вводится — только токен от Microsoft."
                                   Foreground="{StaticResource G.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,14"/>
                        <Button x:Name="MsLoginBtn" Style="{StaticResource PlayButton}" FontSize="13" HorizontalAlignment="Left"
                                Content="{Binding [login_microsoft], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Click="MicrosoftLogin"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassPanel2}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding [login_without_password], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                   FontSize="14.5" FontWeight="ExtraBold" Foreground="{StaticResource G.Text}"/>
                        <TextBlock Text="Локальный профиль по нику — для одиночной игры и серверов без проверки лицензии."
                                   Foreground="{StaticResource G.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/>
                        <TextBox x:Name="OffNick" Style="{StaticResource GInput}" MaxLength="16" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="AddOffline"
                                Content="{Binding [add_account], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
