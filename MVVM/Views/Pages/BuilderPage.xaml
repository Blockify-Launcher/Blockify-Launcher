<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.BuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="960"
      Title="BuilderPage">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource G.Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource G.Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="GInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource G.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource G.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource G.Mono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="10" Background="#40000000" BorderBrush="{StaticResource G.Line}" BorderThickness="1" Padding="12,9">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource G.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="26,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource GlassButton}" Content="←" Margin="0,0,12,0" Padding="12,6"
                    Command="{Binding DataContext.LastPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <TextBlock Text="Создание сборки" FontFamily="{StaticResource G.Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource G.Text}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="Собери свой модпак: выбери ядро, добавь моды — зависимости подтянутся автоматически"
                   Foreground="{StaticResource G.Muted}" FontSize="13" Margin="0,5,0,18"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- col 1: params -->
            <Border Style="{StaticResource GlassPanel2}" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource ColHead}" Text="Параметры"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Название"/>
                    <TextBox x:Name="BName" Style="{StaticResource GInput}" Text="Моя сборка" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Версия игры"/>
                    <ComboBox x:Name="BVer" Style="{StaticResource GlassCombo}" Height="38" Margin="0,0,0,12" SelectionChanged="RefreshTarget">
                        <ComboBoxItem Content="1.21.4" IsSelected="True"/><ComboBoxItem Content="1.20.1"/><ComboBoxItem Content="1.19.2"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Загрузчик"/>
                    <ComboBox x:Name="BLoader" Style="{StaticResource GlassCombo}" Height="38" Margin="0,0,0,12" SelectionChanged="RefreshTarget">
                        <ComboBoxItem Content="Fabric" IsSelected="True"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Quilt"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Описание"/>
                    <TextBox x:Name="BDesc" Style="{StaticResource GInput}" Text=""/>
                </StackPanel>
            </Border>

            <!-- col 2: catalog -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel2}" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColHead}" Text="Каталог модов · Modrinth"/>
                    <TextBox DockPanel.Dock="Top" x:Name="ModSearch" Style="{StaticResource GInput}" Margin="0,0,0,12" TextChanged="FilterMods"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0AFFFFFF" BorderBrush="{StaticResource G.Line}" BorderThickness="1" CornerRadius="11" Padding="10,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/><ColumnDefinition Width="11"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#266BBF3B">
                                                <TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource G.Text}" FontSize="12.5" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="10.5"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="＋" Width="28" Height="28" Click="AddModClick"
                                                    Foreground="{StaticResource G.Primary}" FontWeight="Bold" FontSize="15" Cursor="Hand" Tag="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="B" CornerRadius="8" Background="#246BBF3B" BorderBrush="#736BBF3B" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{StaticResource G.Primary}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4D6BBF3B"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- col 3: composition -->
            <Border Grid.Column="4" Style="{StaticResource GlassPanel2}" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColHead}" Text="Состав сборки"/>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border BorderBrush="{StaticResource G.Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="8" Height="8" x:Name="CompatDot" Fill="{StaticResource G.Primary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CompatText" Text="совместимость: ok" Foreground="{StaticResource G.Primary}" FontSize="11.5" FontWeight="Bold" Margin="7,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="StatMods" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="11" Text="модов: 0"/>
                                <TextBlock x:Name="StatSize" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="11" Text="размер: 0 МБ"/>
                                <TextBlock x:Name="StatTarget" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="11" Text="цель: 1.21.4 · Fabric"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ExportBtn" Style="{StaticResource GlassButton}" Content="Экспорт .mrpack" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="ExportClick"/>
                        <Button x:Name="BuildBtn" Style="{StaticResource PlayButton}" Content="Собрать и играть" FontSize="13" HorizontalAlignment="Stretch" Click="BuildClick"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SlotList">
                            <Border x:Name="EmptyHint" BorderBrush="{StaticResource G.Line}" BorderThickness="1.5" CornerRadius="10" Padding="8,16">
                                <TextBlock Text="Пока пусто — добавь моды из каталога" Foreground="{StaticResource G.Muted}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
