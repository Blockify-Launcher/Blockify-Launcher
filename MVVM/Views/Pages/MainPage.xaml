<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="LoadingMainPage">

    <Page.Resources>
        <DrawingBrush x:Key="PixelRule" TileMode="Tile" Viewport="0,0,12,4" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#B300B558">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="QuickCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB2C0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="QuickCard" TargetType="Border">
            <Setter Property="Background" Value="#C90E1114"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style x:Key="NewsCard" TargetType="Border">
            <Setter Property="Background" Value="#C90E1114"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7300B558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewsBadge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="10,10,0,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="#C00A0C0E"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="248"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- section header -->
        <StackPanel Margin="8,0,0,10" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [news_caption], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                       Foreground="#D5E2EA" FontSize="12" FontWeight="Bold" Margin="0,0,0,5">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <Rectangle Height="4" Fill="{StaticResource PixelRule}"/>
        </StackPanel>

        <!-- magazine layout: featured story + two side stories -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- featured -->
            <Border x:Name="FeaturedCard" Style="{StaticResource NewsCard}" MouseLeftButtonUp="NewsCardClick" Tag="0">
                <Grid>
                    <Border x:Name="FeaturedBg" CornerRadius="13" Background="#FF12253A"/>
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#22000000" Offset="0.25"/>
                                <GradientStop Color="#F00A0D10" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FeaturedBadge" Style="{StaticResource NewsBadge}">
                        <TextBlock x:Name="FeaturedBadgeText" FontSize="9" FontWeight="Bold" Foreground="#FFF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,13">
                        <TextBlock x:Name="FeaturedTitle" Foreground="#FFF" FontSize="17" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="FeaturedDesc" Foreground="#B5C4CF" FontSize="11" LineHeight="15" Margin="0,4,60,0"
                                   TextWrapping="Wrap" MaxHeight="31" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FeaturedDate" Foreground="#8A9BA8" FontSize="9.5" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- side stories -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="Small1Card" Style="{StaticResource NewsCard}" MouseLeftButtonUp="NewsCardClick" Tag="1">
                    <Grid>
                        <Border x:Name="Small1Bg" CornerRadius="13" Background="#FF1A2F52"/>
                        <Border CornerRadius="13">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22000000" Offset="0.2"/>
                                    <GradientStop Color="#F00A0D10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Small1Badge" Style="{StaticResource NewsBadge}">
                            <TextBlock x:Name="Small1BadgeText" FontSize="8.5" FontWeight="Bold" Foreground="#FFF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,9">
                            <TextBlock x:Name="Small1Title" Foreground="#FFF" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Small1Date" Foreground="#8A9BA8" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="Small2Card" Grid.Row="2" Style="{StaticResource NewsCard}" MouseLeftButtonUp="NewsCardClick" Tag="2">
                    <Grid>
                        <Border x:Name="Small2Bg" CornerRadius="13" Background="#FF16324A"/>
                        <Border CornerRadius="13">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22000000" Offset="0.2"/>
                                    <GradientStop Color="#F00A0D10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Small2Badge" Style="{StaticResource NewsBadge}">
                            <TextBlock x:Name="Small2BadgeText" FontSize="8.5" FontWeight="Bold" Foreground="#FFF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,9">
                            <TextBlock x:Name="Small2Title" Foreground="#FFF" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Small2Date" Foreground="#8A9BA8" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- quick row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource QuickCard}">
                <Grid x:Name="ContinueSection">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource QuickCap}"
                                   Text="{Binding [quick_continue], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <TextBlock x:Name="ContinueTitle" Foreground="#FFF" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ContinueSub" Foreground="#5F7280" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="▶" Width="46" Height="46" FontSize="14" Margin="12,0,0,0"
                            Style="{StaticResource EmeraldButton}" Click="ContinueClick"
                            ToolTip="{Binding [quick_continue], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource QuickCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource QuickCap}"
                               Text="{Binding [quick_stats], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatCount" Foreground="#FFF" FontSize="19" FontWeight="Bold"/>
                        <TextBlock x:Name="StatLabel" Foreground="#9FB2C0" FontSize="11" VerticalAlignment="Bottom" Margin="7,0,0,3"/>
                    </StackPanel>
                    <TextBlock x:Name="StatSub" Foreground="#5F7280" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource QuickCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource QuickCap}"
                               Text="{Binding [quick_server], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#5F7280" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerHost" Foreground="#FFF" FontSize="13.5" FontWeight="SemiBold" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ServerStatus" Foreground="#5F7280" FontSize="10.5" Margin="15,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
