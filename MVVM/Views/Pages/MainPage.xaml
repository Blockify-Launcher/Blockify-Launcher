<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      xmlns:controls="clr-namespace:BlockifyLauncher.MVVM.Views.Style.Effect"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="LoadingMainPage">

    <Page.Resources>
        <DrawingBrush x:Key="PixelRule" TileMode="Tile" Viewport="0,0,12,4" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#B300B558">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="QuickCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB2C0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- section header -->
        <StackPanel Margin="6,0,0,10" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [news_caption], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                       Foreground="#D5E2EA" FontSize="12" FontWeight="Bold" Margin="0,0,0,5">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <Rectangle Height="4" Fill="{StaticResource PixelRule}"/>
        </StackPanel>

        <!-- news -->
        <controls:WindowBlur Grid.Row="1"
                BlurRadius="25" Magnification="0.15" Background="Transparent" x:Name="Blur_WindowBlur_Two">
            <Border Background="#C0121212" CornerRadius="15" SizeChanged="ResizeStackPanelNew"
                 BorderBrush="#3F5A5A5A" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" x:Name="StackPanelNews"/>
            </Border>
        </controls:WindowBlur>

        <!-- quick row: continue / stats / favorite server -->
        <controls:WindowBlur Grid.Row="2" Margin="0,14,0,0"
                BlurRadius="25" Magnification="0.15" Background="Transparent" x:Name="Blur_WindowBlur">
            <Border Background="#C0121212" CornerRadius="15" BorderBrush="#3F5A5A5A" BorderThickness="1" Height="86">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- continue -->
                    <Grid x:Name="ContinueSection" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource QuickCap}"
                                       Text="{Binding [quick_continue], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                            <TextBlock x:Name="ContinueTitle" Foreground="#FFF" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ContinueSub" Foreground="#5F7280" FontSize="10.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="▶" Width="46" Height="46" FontSize="14" Margin="12,0,10,0"
                                Style="{StaticResource EmeraldButton}" Click="ContinueClick"
                                ToolTip="{Binding [quick_continue], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                    </Grid>

                    <Rectangle Grid.Column="1" Width="1" Fill="#2BFFFFFF" Margin="14,14"/>

                    <!-- stats -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource QuickCap}"
                                   Text="{Binding [quick_stats], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatCount" Foreground="#FFF" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="StatLabel" Foreground="#9FB2C0" FontSize="11" VerticalAlignment="Bottom" Margin="7,0,0,3"/>
                        </StackPanel>
                        <TextBlock x:Name="StatSub" Foreground="#5F7280" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Width="1" Fill="#2BFFFFFF" Margin="14,14"/>

                    <!-- favorite server -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource QuickCap}"
                                   Text="{Binding [quick_server], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#5F7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServerHost" Foreground="#FFF" FontSize="13.5" FontWeight="SemiBold" Margin="7,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ServerStatus" Foreground="#5F7280" FontSize="10.5" Margin="15,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:WindowBlur>
    </Grid>
</Page>
