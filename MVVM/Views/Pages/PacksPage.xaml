<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.PacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="555" d:DesignWidth="1100"
      Title="PacksPage" Loaded="LoadingPage">

    <Page.Resources>
        <!-- emerald-block filter chip: slot with a hotbar selector ring when active -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9FB2C0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                            <Border x:Name="Pill" CornerRadius="8" Padding="13,6" Background="#FF191C1F"
                                    BorderBrush="#17FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Border x:Name="BevelDark" BorderThickness="1,1,0,0" BorderBrush="#59000000" CornerRadius="8" Margin="-13,-6"/>
                                    <Border x:Name="BevelLight" BorderThickness="0,0,1,1" BorderBrush="#0FFFFFFF" CornerRadius="8" Margin="-13,-6"/>
                                    <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF"/>
                                <Setter TargetName="Pill" Property="Background" Value="#FF22262A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource GreenAccent}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#E8E8E8"/>
                                <Setter TargetName="BevelDark" Property="BorderBrush" Value="#40FFFFFF"/>
                                <Setter TargetName="BevelLight" Property="BorderBrush" Value="#4D000000"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PackCard" TargetType="Border">
            <Setter Property="Background" Value="#C90E1114"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7300B558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- filters + search -->
        <StackPanel Margin="4,0,4,10">
            <DockPanel>
                <!-- search slot -->
                <Border DockPanel.Dock="Right" Width="240" Height="34" CornerRadius="8" Background="#FF15181B" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="BorderBrush" Value="#8C00B558"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="13" Height="13" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Ellipse Width="9" Height="9" Stroke="#5F7280" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Line X1="8" Y1="8" X2="13" Y2="13" Stroke="#5F7280" StrokeThickness="1.6"/>
                        </Grid>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#FFF" FontSize="12.5" CaretBrush="#00B558" VerticalContentAlignment="Center"
                                 Margin="0,0,12,0" KeyDown="SearchKeyDown"/>
                        <TextBlock Grid.Column="1" IsHitTestVisible="False" Foreground="#5F7280" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding [packs_search], Source={x:Static lang:ResxLocalizationProvider.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="loader" Content="{Binding [packs_all], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                 IsChecked="True" Checked="FilterChecked" Tag=""/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="loader" Content="Fabric" Checked="FilterChecked" Tag="fabric"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="loader" Content="Forge" Checked="FilterChecked" Tag="forge"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="loader" Content="NeoForge" Checked="FilterChecked" Tag="neoforge"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="loader" Content="Quilt" Checked="FilterChecked" Tag="quilt"/>
                    <TextBlock x:Name="StatusText" Foreground="#9FB2C0" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- category chips + version + sort -->
            <DockPanel Margin="0,9,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="VersionFilter" Style="{StaticResource CustomComboBox}" Width="130" Height="32"
                              Tag="SettingComboBox" BorderThickness="1" Margin="0,0,8,0" SelectionChanged="RefineChanged"/>
                    <ComboBox x:Name="SortFilter" Style="{StaticResource CustomComboBox}" Width="150" Height="32"
                              Tag="SettingComboBox" BorderThickness="1" SelectionChanged="RefineChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_all], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                 IsChecked="True" Checked="CategoryChecked" Tag=""/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_optimization], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="optimization"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_adventure], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="adventure"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_magic], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="magic"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_technology], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="technology"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_quests], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="quests"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="cat" Content="{Binding [cat_combat], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Checked="CategoryChecked" Tag="combat"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PacksList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PackCard}" Cursor="Hand" MouseLeftButtonUp="OpenPackPage">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="108"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- banner: featured gallery shot -->
                                <Border CornerRadius="15,15,0,0" Background="#FF16324A">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Background="White" CornerRadius="15,15,0,0" Width="340" Height="108"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Grid>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding BannerUrl}" Stretch="UniformToFill"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#22000000" Offset="0"/>
                                                    <GradientStop Color="#D90E1114" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <!-- loader badge -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,9,0,0"
                                        CornerRadius="5" Padding="7,2" Background="#C00A0C0E"
                                        BorderBrush="#5900B558" BorderThickness="1">
                                    <TextBlock Text="{Binding Loader}" FontSize="9.5" FontWeight="Bold" Foreground="#00B558"/>
                                </Border>

                                <!-- icon over banner bottom-left -->
                                <Border Width="46" Height="46" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="12,0,0,10" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#FF14181C">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="13,9,13,12">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFF" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#9FB2C0" FontSize="10.5" LineHeight="15"
                                               TextWrapping="Wrap" Height="31" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding GameVersion}" Foreground="#9FB2C0" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="⤓" Foreground="#5F7280" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadsText}" Foreground="#5F7280" FontSize="11"
                                                       VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="{Binding [packs_open], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                                Style="{StaticResource GhostButton}" FontSize="11" Height="30" Padding="13,0"
                                                HorizontalAlignment="Right" Click="OpenPackPage"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
