<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.PacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="555" d:DesignWidth="1100"
      Title="PacksPage" Loaded="LoadingPage">

    <Page.Resources>
        <!-- pill filter chip -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9FB2C0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="999" Padding="14,6" Background="#B80D0F12"
                                BorderBrush="#17FFFFFF" BorderThickness="1">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource GreenAccent}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PackCard" TargetType="Border">
            <Setter Property="Background" Value="#C90E1114"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7300B558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- filters + search -->
        <DockPanel Margin="4,0,4,12">
            <Grid DockPanel.Dock="Right" Width="230" Height="33">
                <TextBox x:Name="SearchBox" Style="{StaticResource CustomTextBox}" FontSize="13"
                         BorderBrush="#3F5A5A5A" BorderThickness="1" KeyDown="SearchKeyDown"/>
                <TextBlock IsHitTestVisible="False" Foreground="#5F7280" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="{Binding [packs_search], Source={x:Static lang:ResxLocalizationProvider.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip}" Content="{Binding [packs_all], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                             IsChecked="True" Checked="FilterChecked" Tag=""/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Fabric" Checked="FilterChecked" Tag="fabric"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Forge" Checked="FilterChecked" Tag="forge"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="NeoForge" Checked="FilterChecked" Tag="neoforge"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Quilt" Checked="FilterChecked" Tag="quilt"/>
                <TextBlock x:Name="StatusText" Foreground="#9FB2C0" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PacksList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PackCard}" Cursor="Hand" MouseLeftButtonUp="OpenPackPage">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="108"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- banner: featured gallery shot -->
                                <Border CornerRadius="15,15,0,0" Background="#FF16324A">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Background="White" CornerRadius="15,15,0,0" Width="340" Height="108"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Grid>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding BannerUrl}" Stretch="UniformToFill"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#22000000" Offset="0"/>
                                                    <GradientStop Color="#D90E1114" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <!-- loader badge -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,9,0,0"
                                        CornerRadius="5" Padding="7,2" Background="#C00A0C0E"
                                        BorderBrush="#5900B558" BorderThickness="1">
                                    <TextBlock Text="{Binding Loader}" FontSize="9.5" FontWeight="Bold" Foreground="#00B558"/>
                                </Border>

                                <!-- icon over banner bottom-left -->
                                <Border Width="46" Height="46" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="12,0,0,10" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#FF14181C">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="13,9,13,12">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFF" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#9FB2C0" FontSize="10.5" LineHeight="15"
                                               TextWrapping="Wrap" Height="31" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding GameVersion}" Foreground="#9FB2C0" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="⤓" Foreground="#5F7280" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadsText}" Foreground="#5F7280" FontSize="11"
                                                       VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="→" Foreground="#00B558" FontWeight="Bold" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
