<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.PacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="PacksPage" Loaded="LoadingPage">

    <Grid Margin="26,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [nav_packs], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                   FontFamily="{StaticResource G.Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource G.Text}"/>
        <TextBlock Grid.Row="1" Text="Готовые модпаки — установка в один клик, поиск по каталогу Modrinth"
                   Foreground="{StaticResource G.Muted}" FontSize="13" Margin="0,5,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">
                <!-- filters -->
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="🛠 Создать сборку" Cursor="Hand"
                            Command="{Binding DataContext.BuilderCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12" Padding="15,7" Background="#D96BBF3B">
                                    <ContentPresenter TextBlock.Foreground="#0C1506" TextBlock.FontWeight="Bold" TextBlock.FontSize="12"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource GlassChip}" GroupName="loader" Content="{Binding [packs_all], Source={x:Static lang:ResxLocalizationProvider.Instance}}" IsChecked="True" Checked="FilterChecked" Tag=""/>
                        <RadioButton Style="{StaticResource GlassChip}" GroupName="loader" Content="Fabric" Checked="FilterChecked" Tag="fabric"/>
                        <RadioButton Style="{StaticResource GlassChip}" GroupName="loader" Content="Forge" Checked="FilterChecked" Tag="forge"/>
                        <RadioButton Style="{StaticResource GlassChip}" GroupName="loader" Content="NeoForge" Checked="FilterChecked" Tag="neoforge"/>
                        <RadioButton Style="{StaticResource GlassChip}" GroupName="loader" Content="Quilt" Checked="FilterChecked" Tag="quilt"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource G.Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="PacksList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource G.Glass2}" BorderBrush="{StaticResource G.Line}" BorderThickness="1"
                                    CornerRadius="16" Margin="7" Cursor="Hand" MouseLeftButtonUp="OpenPackPage">
                                <StackPanel>
                                    <Border CornerRadius="16,16,0,0" Height="110">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding BannerUrl}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Border CornerRadius="16,16,0,0" Padding="10" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border CornerRadius="5" Padding="7,2" Background="#A60B0E10">
                                                <TextBlock Text="{Binding Loader}" Foreground="{StaticResource G.Primary}" FontFamily="{StaticResource G.Mono}" FontSize="10"/>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <StackPanel Margin="14">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource G.Text}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource G.Muted}" FontSize="12" TextWrapping="Wrap" Height="34" Margin="0,5,0,10" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding GameVersion}" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="10.5"/>
                                            <TextBlock Text="  ·  ⤓" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="10.5"/>
                                            <TextBlock Text="{Binding DownloadsText}" Foreground="{StaticResource G.Muted}" FontFamily="{StaticResource G.Mono}" FontSize="10.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="{Binding [packs_open], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                                Style="{StaticResource GlassButtonPrimary}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OpenPackPage"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
