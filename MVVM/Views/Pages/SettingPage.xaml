<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="SettingPage" Loaded="LoadingPages">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource G.Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="GInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource G.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource G.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource G.Mono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" CornerRadius="10" Background="#40000000" BorderBrush="{StaticResource G.Line}" BorderThickness="1" Padding="12,9"
                                Height="{TemplateBinding Height}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource G.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- switch row: label left, toggle right -->
        <Style x:Key="SwitchToggleG" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" Width="40" Height="22" CornerRadius="11" Background="#14FFFFFF" BorderBrush="{StaticResource G.Line}" BorderThickness="1">
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="#CFD8D0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#D96BBF3B"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="26,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [nav_settings], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                   FontFamily="{StaticResource G.Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource G.Text}"/>
        <TextBlock Grid.Row="1" Text="Параметры игры и самого лаунчера" Foreground="{StaticResource G.Muted}" FontSize="13" Margin="0,5,0,18"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── game ── -->
                <Border Style="{StaticResource GlassPanel2}" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding [sec_game], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                   FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource G.Text}" Margin="0,0,0,14"/>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center">
                                <Run Text="{Binding [ram_utilization], Source={x:Static lang:ResxLocalizationProvider.Instance}, Mode=OneWay}"/>
                                <Run Text=" — "/><Run x:Name="RamRun" Foreground="#F2C14E"/>
                            </TextBlock>
                        </DockPanel>
                        <Slider x:Name="SliderRam" Margin="0,0,0,16" ValueChanged="SliderRAMValueChanged"
                                TickFrequency="512" IsSnapToTickEnabled="True"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [java_version], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <ComboBox x:Name="JavaVersion" Style="{StaticResource GlassCombo}" Height="38" Margin="0,0,0,14" SelectionChanged="JavaVersionSelect"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [display_size], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBox x:Name="WidthScrean" Style="{StaticResource GInput}" Width="86" Height="38" PreviewTextInput="NumsPreviewTextInput"/>
                            <TextBlock Text="⨉" Foreground="{StaticResource G.Muted}" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="HeightScrean" Style="{StaticResource GInput}" Width="86" Height="38" PreviewTextInput="NumsPreviewTextInput"/>
                            <CheckBox x:Name="FullScreanCheckBox" Style="{StaticResource SwitchToggleG}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding [fullscreen], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Foreground="{StaticResource G.Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [minecraft_path], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="…" Padding="14,8" Margin="8,0,0,0" Click="PathMinecraft"/>
                            <TextBox x:Name="MinecraftPath_TextBox" Style="{StaticResource GInput}" Height="38" IsReadOnly="True" FontSize="11"/>
                        </DockPanel>

                        <Button Content="{Binding [apply_button], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                Style="{StaticResource PlayButton}" FontSize="13" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ApplySettingScrean"/>
                    </StackPanel>
                </Border>

                <!-- ── launcher ── -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanel2}" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding [sec_launcher], Source={x:Static lang:ResxLocalizationProvider.Instance}}"
                                   FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource G.Text}" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [launcher_language], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <ComboBox x:Name="ComboBoxLauncherLanguage" Style="{StaticResource GlassCombo}" Height="38" Margin="0,0,0,14" SelectionChanged="ComboBoxLauncherLanguageSelect"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [hide_launcher], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <ComboBox x:Name="ComboBoxDisplayForm" Style="{StaticResource GlassCombo}" Height="38" Margin="0,0,0,14" SelectionChanged="ComboBoxDisplayFormSelect">
                            <ComboBoxItem Content="{Binding [hide], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                            <ComboBoxItem Content="{Binding [show], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [favorite_server_label], Source={x:Static lang:ResxLocalizationProvider.Instance}}"/>
                        <TextBox x:Name="FavoriteServerTextBox" Style="{StaticResource GInput}" Height="38" Margin="0,0,0,6" LostFocus="FavoriteServerChanged"/>

                        <Border BorderBrush="{StaticResource G.Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <CheckBox x:Name="SwitchAikar" DockPanel.Dock="Right" Style="{StaticResource SwitchToggleG}" Checked="AikarChanged" Unchecked="AikarChanged"/>
                                    <TextBlock Text="{Binding [jvm_aikar], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Foreground="{StaticResource G.Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <CheckBox x:Name="SwitchDiscord" DockPanel.Dock="Right" Style="{StaticResource SwitchToggleG}" Checked="DiscordChanged" Unchecked="DiscordChanged"/>
                                    <TextBlock Text="{Binding [discord_label], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Foreground="{StaticResource G.Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <CheckBox x:Name="SwitchSnapshots" DockPanel.Dock="Right" Style="{StaticResource SwitchToggleG}" Checked="VersionFilterChanged" Unchecked="VersionFilterChanged"/>
                                    <TextBlock Text="{Binding [show_snapshots], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Foreground="{StaticResource G.Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <CheckBox x:Name="SwitchBetas" DockPanel.Dock="Right" Style="{StaticResource SwitchToggleG}" Checked="VersionFilterChanged" Unchecked="VersionFilterChanged"/>
                                    <TextBlock Text="{Binding [show_betas], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Foreground="{StaticResource G.Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <CheckBox x:Name="SwitchAlphas" Visibility="Collapsed" IsChecked="False"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="{Binding [check_updates], Source={x:Static lang:ResxLocalizationProvider.Instance}}" Click="CheckUpdatesClick"/>
                            <Button Style="{StaticResource GlassButton}" Content="{Binding [clear_cache], Source={x:Static lang:ResxLocalizationProvider.Instance}}" HorizontalAlignment="Left" Click="ClearCacheClick"/>
                        </DockPanel>
                        <TextBlock x:Name="VersionLabel" Foreground="{StaticResource G.Disabled}" FontFamily="{StaticResource G.Mono}" FontSize="10.5" Margin="0,12,0,0"/>
                        <TextBlock x:Name="CacheSizeText" Visibility="Collapsed"/>
                        <TextBlock x:Name="RamValueText" Visibility="Collapsed"/>
                        <ComboBox x:Name="ComboBoxVibe" Visibility="Collapsed"/>
                        <CheckBox x:Name="SwitchParade" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
