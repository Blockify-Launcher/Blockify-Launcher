<Page x:Class="BlockifyLauncher.MVVM.Views.Pages.VersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BlockifyLauncher.MVVM.Views.Pages"
      xmlns:lang="clr-namespace:BlockifyLauncher.Resources"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="VersionsPage" Loaded="LoadingPage">

    <Page.Resources>
        <Style x:Key="VRow" TargetType="Border" BasedOn="{StaticResource GlassPanel2}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid Margin="26,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление версиями" FontFamily="{StaticResource G.Display}" FontWeight="Bold" FontSize="21" Foreground="{StaticResource G.Text}"/>
        <TextBlock Grid.Row="1" Text="Установленные версии и загрузчики. Список тянется из Mojang и локальных установок."
                   Foreground="{StaticResource G.Muted}" FontSize="13" Margin="0,5,0,18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Style="{StaticResource GlassChip}" GroupName="vf" Content="Все" IsChecked="True" Checked="FilterChecked" Tag="all"/>
            <RadioButton Style="{StaticResource GlassChip}" GroupName="vf" Content="Релизы" Checked="FilterChecked" Tag="release"/>
            <RadioButton Style="{StaticResource GlassChip}" GroupName="vf" Content="Снапшоты" Checked="FilterChecked" Tag="snapshot"/>
            <RadioButton Style="{StaticResource GlassChip}" GroupName="vf" Content="Старые" Checked="FilterChecked" Tag="old"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource G.Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VersionsList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource VRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{Binding IconBrush}">
                                    <TextBlock Text="{Binding IconText}" Foreground="{Binding IconFg}" FontFamily="{StaticResource G.Mono}"
                                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource G.Text}" FontFamily="{StaticResource G.Mono}" FontSize="14"/>
                                    <TextBlock Text="{Binding Info}" Foreground="{StaticResource G.Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="3" CornerRadius="6" Padding="9,3" VerticalAlignment="Center" Background="#296BBF3B">
                                    <TextBlock Text="{Binding Badge}" Foreground="{StaticResource G.Primary}" FontFamily="{StaticResource G.Mono}" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
