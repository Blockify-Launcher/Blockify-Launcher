<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Blockify design system: Minecraft DNA ============ -->

    <Color x:Key="EmeraldHiColor">#3ED160</Color>
    <Color x:Key="EmeraldColor">#2CB14A</Color>
    <Color x:Key="EmeraldLoColor">#1F8F3A</Color>
    <Color x:Key="EmeraldBaseColor">#14632A</Color>
    <SolidColorBrush x:Key="XpText" Color="#7DFF5F"/>
    <SolidColorBrush x:Key="GlassPanel" Color="#B80E1114"/>
    <SolidColorBrush x:Key="GlassLine" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="MutedText" Color="#9FB2C0"/>

    <LinearGradientBrush x:Key="EmeraldFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource EmeraldHiColor}" Offset="0"/>
        <GradientStop Color="{StaticResource EmeraldColor}" Offset="0.48"/>
        <GradientStop Color="{StaticResource EmeraldLoColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenAccent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#009046" Offset="0"/>
        <GradientStop Color="#00B558" Offset="1"/>
    </LinearGradientBrush>

    <!-- Emerald block button: light top facet, dark bottom, 5px plinth, presses down -->
    <Style x:Key="EmeraldButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BlockPlinth" Background="#FF14632A" CornerRadius="8" Margin="0,6,0,0"/>
                        <Border x:Name="BlockFace" Background="{StaticResource EmeraldFace}" CornerRadius="8" Margin="0,0,0,5">
                            <Grid>
                                <Border VerticalAlignment="Top" Height="3" Background="#59FFFFFF" CornerRadius="8,8,0,0" Margin="1,1,1,0"/>
                                <Border VerticalAlignment="Bottom" Height="4" Background="#40000000" CornerRadius="0,0,8,8" Margin="1,0,1,1"/>
                                <Border x:Name="HoverVeil" Background="Transparent" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.45"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverVeil" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BlockFace" Property="Margin" Value="0,4,0,1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP-style progress bar: dark track, glowing segmented green fill -->
    <DrawingBrush x:Key="XpNotches" TileMode="Tile" Viewport="0,0,12,9" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#59000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="11,0,1,9"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="XpProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#FF0B1C12" BorderBrush="#4079FF5F" BorderThickness="1" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Margin="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#9BFF6B" Offset="0"/>
                                    <GradientStop Color="#3ED160" Offset="0.45"/>
                                    <GradientStop Color="#1F8F3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="9" ShadowDepth="0" Color="#7DFF5F" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>
                        <Rectangle Fill="{StaticResource XpNotches}" Margin="1" RadiusX="2" RadiusY="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minecraft item tooltip: dark plum, purple gradient border, square corners.
         Implicit style — every ToolTip in the app gets the look. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F0100010" BorderThickness="2" Padding="9,6">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B1FD8" Offset="0"/>
                                <GradientStop Color="#2A0A63" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <ContentPresenter TextBlock.Foreground="White" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="12">
                            <ContentPresenter.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.6"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotbar navigation slot: inventory-slot bevel, active = selector frame + green -->
    <Style x:Key="HotbarSlot" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                        <Border x:Name="Slot" CornerRadius="10" Background="#FF191C1F">
                            <Grid>
                                <Border BorderThickness="2,2,0,0" BorderBrush="#8C000000" CornerRadius="10" x:Name="BevelDark"/>
                                <Border BorderThickness="0,0,2,2" BorderBrush="#14FFFFFF" CornerRadius="10" x:Name="BevelLight"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Slot" Property="Background" Value="#FF23272B"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Slot" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#009046" Offset="0"/>
                                        <GradientStop Color="#00B558" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#E8E8E8"/>
                            <Setter TargetName="BevelDark" Property="BorderBrush" Value="#40FFFFFF"/>
                            <Setter TargetName="BevelLight" Property="BorderBrush" Value="#4D000000"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#00B558" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small caps caption above dock fields -->
    <Style x:Key="DockCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,3"/>
    </Style>

    <!-- Dark dropdown items (implicit, app-wide) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#DDE6EC"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="9,6" Margin="1">
                        <ContentPresenter TextBlock.FontSize="13"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#3D009046"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Green slider: thin track, filled part, square white thumb -->
    <Style x:Key="GreenSlider" TargetType="Slider">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource GreenAccent}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False" Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="13" Height="13" CornerRadius="3" Background="#E8E8E8"
                                                    BorderBrush="#9A9A9A" BorderThickness="0,0,1,1" Cursor="Hand"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin dark scrollbar (implicit) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False" Command="ScrollBar.PageUpCommand" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False" Command="ScrollBar.PageDownCommand" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4DFFFFFF" CornerRadius="3.5" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="7"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost button: quiet translucent, for secondary actions -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="#12FFFFFF" CornerRadius="11"
                            BorderBrush="{StaticResource GlassLine}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
